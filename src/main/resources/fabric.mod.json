{
  "schemaVersion": 1,
  "id": "nvidium_world_cache",
  "version": "${version}",
  "name": "Nvidium World Cache",
  "description": "Stores distant terrain for Nvidium and generates new chunks in singleplayer worlds.",
  "license": "MIT",
  "contact": {
    "sources": "https://github.com/Samurai-n/nvidium-world-gen",
    "issues": "https://github.com/Samurai-n/nvidium-world-gen/issues"
  },
  "environment": "client",
  "entrypoints": { "client": ["dev.nvidiumcache.fabric.WorldCacheClient"], "modmenu": ["dev.nvidiumcache.fabric.config.ModMenuIntegration"], "sodium:config_api_user": ["dev.nvidiumcache.fabric.config.SodiumConfigIntegration"] },
  "suggests": { "modmenu": "21.x", "cloth-config": "26.3.x" },
  "mixins": ["nvidium-world-cache.mixins.json"],
  "depends": {
    "fabricloader": ">=0.19.5",
    "fabric-api": ">=0.161.0",
    "minecraft": "26.3",
    "java": ">=25",
    "nvidium": "0.4.4-beta7-26.3",
    "sodium": "0.9.2"
  }
}
